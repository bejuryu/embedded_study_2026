# Set default behavior to normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files to always use LF (Line Feed)
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Deny text normalization for binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
